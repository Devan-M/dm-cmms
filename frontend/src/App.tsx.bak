import React, { useState, useEffect } from 'react';
import { BrowserRouter as Router, Routes, Route, Navigate, useNavigate } from 'react-router-dom';

// Layout shell com sidebar
import Layout from './components/Layout';

// P«≠ginas da aplica«ı«úo
import Dashboard from './pages/Dashboard';
import Equipamentos from './pages/Equipamentos';
import EquipamentoDetalhe from './pages/EquipamentoDetalhe';
import Ordens from './pages/Ordens';
import OrdemDetalhe from './pages/OrdemDetalhe';
import Login from './components/Login';
import NotFound from './pages/NotFound';

/**
 * Verifica se h«≠ token no localStorage para autentica«ı«úo
 */
function isAuth(): boolean {
  return localStorage.getItem('token') !== null;
}

// Guard de autentica«ı«úo - redireciona para /login se n«úo tiver token
function requireAuth() {
  const navigate = useNavigate();
  
  useEffect(() => {
    if (!isAuth()) {
      navigate('/login');
    }
  }, [navigate]);
  
  // Componente vazio que sempre retorna null quando requer auth
  return null as React.ReactElement;
}

/**
 * App.tsx É?" Raiz da aplica«ı«úo DM-CMMS
 * Rotas protegidas verificam token no localStorage e redirecionam para /login se necess«≠rio.
 */
function App() {
  const [equipamentos, setEquipamentos] = useState([
    { id: 1, nome: 'Torno Mec«Ωnico Nardini', codigo: 'TOR-01', setor: 'Usinagem', criticidade: 'Alta', status: 'Operacional', dataCadastro: '28/10/2026' },
    { id: 2, nome: 'Compressor de Ar Schulz', codigo: 'CMP-02', setor: 'Utilidades', criticidade: 'Cr«tica', status: 'Em Manuten«ı«úo', dataCadastro: '29/10/2026' },
    { id: 3, nome: 'Rob«Ô de Solda Yaskawa', codigo: 'SLD-05', setor: 'Soldagem', criticidade: 'Alta', status: 'Operacional', dataCadastro: '30/10/2026' },
    { id: 4, nome: 'Prensa Hidr«≠ulica Romi', codigo: 'PRN-08', setor: 'Estamparia', criticidade: 'M«∏dia', status: 'Operacional', dataCadastro: '01/11/2026' },
  ]);

  const [ordens, setOrdens] = useState([
    { id: 1001, equipamento: 'Compressor de Ar Schulz', equipamentoId: 2, tipo: 'Corretiva', prioridade: 'Alta', status: 'Em Andamento', responsavel: 'Carlos Melo', descricao: 'Substitui«ı«úo do filtro de ar e revis«úo do sistema de press«úo.', dataAbertura: '29/10/2026' },
    { id: 1002, equipamento: 'Torno Mec«Ωnico Nardini', equipamentoId: 1, tipo: 'Preventiva', prioridade: 'M«∏dia', status: 'Em Aberto', responsavel: 'Ana Silva', descricao: 'Lubrifica«ı«úo geral e verifica«ı«úo de folgas.', dataAbertura: '01/11/2026' },
    { id: 1003, equipamento: 'Rob«Ô de Solda Yaskawa', equipamentoId: 3, tipo: 'Inspe«ı«úo', prioridade: 'Baixa', status: 'Conclu«da', responsavel: 'Pedro Costa', descricao: 'Inspe«ı«úo peri«¸dica semestral de rotina.', dataAbertura: '30/10/2026' },
  ]);

  const handleAddEquipamento = (novo) => { setEquipamentos((prev) => [novo, ...prev]); };
  const handleToggleEquipamento = (id) => {
    setEquipamentos((prev) => prev.map((eq) =>
      eq.id === id ? { ...eq, status: eq.status === 'Operacional' ? 'Em Manuten«ı«úo' : 'Operacional' } : eq
    ));
  };
  const handleDeleteEquipamento = (id) => { setEquipamentos((prev) => prev.filter((eq) => eq.id !== id)); };

  const handleAddOrdem = (nova) => { setOrdens((prev) => [nova, ...prev]); };
  const handleUpdateStatusOrdem = (id, novoStatus) => {
    setOrdens((prev) => prev.map(os => os.id === id ? { ...os, status: novoStatus } : os));
  };

  return (
    <Router>
      <Routes>
        {/* Rota de Login - acess«vel para todos */}
        <Route path="/login" element={<Login />} />

        {/* Guard de autentica«ı«úo */}
        <Route path="/" element={requireAuth()} />

        {/* Layout shell envolve todas as p«≠ginas protegidas */}
        <Route path="/" element={<Layout equipamentos={equipamentos} ordens={ordens} />}>
          <Route index element={<Dashboard equipments={equipamentos} ordens={ordens} />} />

          <Route path="equipamentos" element={<Equipamentos equipments={equipamentos} onAdd={handleAddEquipamento} onToggle={handleToggleEquipamento} onDelete={handleDeleteEquipamento} />} />
          <Route path="equipamentos/:id" element={<EquipamentoDetalhe equipments={equipamentos} onToggle={handleToggleEquipamento} onDelete={handleDeleteEquipamento} />} />

          <Route path="ordens" element={<Ordens ordens={ordens} equipments={equipamentos} onAddOrdem={handleAddOrdem} />} />
          <Route path="ordens/:id" element={<OrdemDetalhe ordens={ordens} onUpdateStatus={handleUpdateStatusOrdem} />} />
        </Route>

        <Route path="*" element={<NotFound />} />
      </Routes>
    </Router>
  );
}

export default App;
